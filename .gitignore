# Do not delete items from .gitignore.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
*.egg-info/
.eggs/
dist/

# IDE settings Pycharm/VSCode/Visual Studio
.idea
.vscode
*.sln

# pytest
.pytest_cache
.mypy_cache

# IPython Notebook
.ipynb_checkpoints
notebooks/data/*
!notebooks/data/.gitkeep

# Sphinx documentation
docs/build/*
docs/source/reference/generated/*rst

# managing secrets
.ini
.env

# Agent files (specific to user setup potentially)
AGENTS.md
